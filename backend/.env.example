# Supabase Postgres connection string (Project Settings > Database > Connection string > URI)
# Use the "Transaction" pooler connection string for serverless/edge, "Session" for local dev.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# OPTIONAL. Database for the test suite. Left UNSET on purpose - the team chose to run tests
# against DATABASE_URL above (the app's own database) for the hackathon; see CLAUDE.md,
# "The test suite shares the app's database". Consequences, briefly: sequences on real tables
# advance, do not run the suite during a demo, and one unreproducible failure per full run is
# expected rather than a bug.
#
# To separate them later, uncomment and point this at any other Postgres - a second Supabase
# project, or a local container - then create its schema:
#   cd backend && DATABASE_URL="<that url>" venv/Scripts/python.exe -m alembic upgrade head
# A local option, if you would rather not spend a Supabase project (the pgvector IMAGE matters:
# migration fd046d263fe1 runs CREATE EXTENSION vector, which plain `postgres` cannot satisfy):
#   docker run -d --name eduops-test-db -p 5433:5432 \
#     -e POSTGRES_PASSWORD=testpass -e POSTGRES_DB=eduops_test pgvector/pgvector:pg16
# TEST_DATABASE_URL=postgresql://postgres:testpass@localhost:5433/eduops_test

# Supabase project settings (Project Settings > API).
# SUPABASE_URL is used to fetch the project's JWKS to verify auth JWTs
# (ES256, Supabase's current default) - no shared secret needed.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

ENVIRONMENT=development

# Google Gemini API key - powers the RAG pipeline (embeddings) and the Doubt Bot
# (generation). See app/services/llm.py; the app fails loudly at import without it.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
