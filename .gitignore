# Env files
.env
.env.local
.env.*.local
frontend/.env
backend/.env

# Frontend (Node)
node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*
# tsc -b artifacts: tsconfig.node.json sets "composite": true, so a project build
# emits an incremental cache plus a compiled copy of vite.config.ts NEXT TO the
# source (not into dist/). Build output, never source - see frontend/tsconfig.node.json.
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Source PDFs dropped at the repo root for one-off resource uploads. fecu101.pdf is a
# 2.7 MB NCERT Grade 6 science chapter that got swept into commit 548c5e1 by a
# `git add -A`. This rule does NOT untrack it - git ignores only UNtracked paths - it
# just stops it (and its siblings) being re-added after a future removal. To actually
# stop tracking it without rewriting history: `git rm --cached fecu101.pdf`, which
# leaves the file on disk and the old commit intact.
/*.pdf

# Backend (Python)
__pycache__/
*.pyc
*.pyo
venv/
.venv/
backend/venv/
backend/.venv/
*.egg-info/
.pytest_cache/
.pip-tmp/
backend/var/
# pytest-cov output (added with the pytest-cov dev dep in requirements.txt)
.coverage
.coverage.*
htmlcov/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

.claude/
CLAUDE.md

# Local SQLite scratch DB used by some backend tests. backend/test_eduops.db is
# already tracked (committed on the person-B branch) - this only stops NEW copies
# from being added. To stop git showing churn on the tracked one:
#   git update-index --skip-worktree backend/test_eduops.db
# Removing the tracked file is Person B's call, not something the merge did.
*.db
!backend/test_eduops.db